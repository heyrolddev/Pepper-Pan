# Copy to .env.local and fill in from your Supabase project settings (Project → Settings → API).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose to the browser.
# Required for scripts/seed.mjs; not needed to run the app itself.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications (optional) --------------------------------------------
# Web Push: the only channel that reaches a phone with the browser closed,
# and it costs nothing. There is no account and no vendor — you generate the
# keypair yourself, once:
#
#     npx web-push generate-vapid-keys
#
# Paste the two values below. With them unset, the Alerts screen says so and
# everything else works exactly as before.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if this site misbehaves. Optional.
VAPID_SUBJECT=mailto:peppperpan@gmail.com

# Email status updates. Optional and paid — with these unset, nothing is sent
# and nothing breaks.
RESEND_API_KEY=
SHOP_FROM_EMAIL=
