# Copy to .env.local and fill in from your Supabase project settings (Project → Settings → API).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose to the browser.
# Required by HQ screens that read costs and stock, and by `npm run restore`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifications (optional) --------------------------------------------
# Web Push: the only channel that reaches a phone with the browser closed,
# and it costs nothing. There is no account and no vendor — you generate the
# keypair yourself, once:
#
#     npx web-push generate-vapid-keys
#
# Paste the two values below. With them unset, the Alerts screen says so and
# everything else works exactly as before.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if this site misbehaves. Optional.
VAPID_SUBJECT=mailto:peppperpan@gmail.com

# Email status updates. Optional and paid — with these unset, nothing is sent
# and nothing breaks.
RESEND_API_KEY=
SHOP_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Error alerting (optional)
#
# The shop already records every fault in its own database and shows them on
# the HQ dashboard, and pushes the owner the first time a new one appears.
# None of that needs anything here.
#
# Sentry is the second layer, and it buys two things the shop's own log
# cannot: a stack trace that points at the real line rather than at minified
# code, and reporting that still works when the database itself is the thing
# that is down. Leave these blank and nothing changes — no warnings, no cost,
# no code path taken.
#
# The DSN is NEXT_PUBLIC_ because it ships to the browser. That is by design:
# a DSN names a project to send to and grants nothing.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time. Without them Sentry still
# reports; the stack is just harder to read.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
