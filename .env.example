# Copy to .env.local and fill in from your Supabase project settings (Project → Settings → API).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose to the browser.
# Required for scripts/seed.mjs; not needed to run the app itself.
SUPABASE_SERVICE_ROLE_KEY=
